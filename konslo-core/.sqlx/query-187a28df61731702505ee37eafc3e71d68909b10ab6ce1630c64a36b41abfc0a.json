  "query": "INSERT INTO checks (habit_id, value, checked_at)\nVALUES ($1, $2, $3)\nON CONFLICT (habit_id, ((checked_at AT TIME ZONE 'UTC')::date))\nDO UPDATE SET value = checks.value + EXCLUDED.value\nRETURNING\n    check_id as id,\n    habit_id, value,\n    checked_at;",
